{
  "name": "quiz-night",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/server\" --filter \"./apps/web\" dev",
    "build": "pnpm --filter @quiz/web build",
    "start": "pnpm --filter @quiz/server start",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "cd apps/server && node e2e.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}