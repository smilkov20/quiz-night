{
  "name": "quiz-night",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/server\" --filter \"./apps/web\" dev",
    "build": "pnpm --filter @quiz/web build",
    "start": "pnpm --filter @quiz/server start",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "cd apps/server && node e2e.mjs",
    "simulate": "pnpm --filter @quiz/server simulate",
    "hash-password": "pnpm --filter @quiz/server hash-password",
    "verify": "node scripts/verify-wiring.mjs",
    "test": "pnpm --filter @quiz/web build && pnpm verify && echo \"--- start the server, then: pnpm test:e2e && pnpm simulate\""
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}